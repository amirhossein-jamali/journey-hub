{
  "name": "Journey Hub Backend",
  "dockerFile": "Dockerfile",
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=delegated",
  "forwardPorts": [8080, 9090],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "go.goroot": "/usr/local/go",
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--fast"],
        "editor.formatOnSave": true,
        "go.formatTool": "gofmt",
        "go.testFlags": ["-v"],
        "go.testTimeout": "300s",
        "go.coverageDecorator": {
          "type": "highlight",
          "coveredHighlightColor": "rgba(64,128,128,0.5)",
          "uncoveredHighlightColor": "rgba(128,64,64,0.25)"
        },
        "go.coverOnSave": true,
        "go.coverOnSingleTest": true,
        "go.coverageOptions": "showBothCoveredAndUncoveredCode",
        "[go]": {
          "editor.codeActionsOnSave": {
            "source.organizeImports": true
          }
        }
      },
      "extensions": [
        "golang.go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "42crunch.vscode-openapi",
        "rangav.vscode-thunder-client",
        "ahmadalli.vscode-nginx-conf",
        "ms-vscode.makefile-tools",
        "gruntfuggly.todo-tree",
        "cweijan.vscode-database-client2"
      ]
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "go mod download && go mod verify && ./scripts/install-hooks.sh && chmod +x ./scripts/init-swagger.sh && ./scripts/init-swagger.sh",
  "features": {
    "docker-in-docker": "latest"
  },
  "postStartCommand": "echo 'Dev container started. Run ./scripts/init-swagger.sh to update Swagger documentation'"
} 